<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.6 mods target .NET Framework 4.7.2 (Unity 2022.3 / Mono). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AnimalSlaughterManager</AssemblyName>
    <RootNamespace>ASM</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>

    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld 1.6 API (reference-only; nothing is copied into Assemblies/). -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" PrivateAssets="all" />
    <!-- Harmony ships inside RimWorld; we only need it at compile time. -->
    <PackageReference Include="Lib.Harmony" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
